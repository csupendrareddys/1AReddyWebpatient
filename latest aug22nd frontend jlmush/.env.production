# Production build-time environment for Vite.
#
# This file is COMMITTED to git intentionally. Every value here is
# PUBLIC by design — Vite bakes them into the client bundle, which
# every browser downloads and inspects. Do NOT put secrets here:
#   * Server-side API keys (OpenAI, AWS access key, JWT secret) → GitHub Actions secrets
#   * Anything that grants access if leaked                     → GitHub Actions secrets
#
# Why this file exists:
#   CI-dashboard env vars (originally Amplify, now the GitHub Actions
#   Pages-deploy workflow) were not reliably propagated to the Vite
#   build subprocess. Committing the canonical production values
#   here guarantees the bundle has them regardless of CI plumbing.
#
# Local dev: Vite picks .env.development (already tracked); this file
# only loads when running `vite build` or NODE_ENV=production.
#
# ─────────────────────────────────────────────────────────────────────
# ONE-DOMAIN MODEL (2026-08-20): production is the greenfield jlmush.in
# stack in AWS 510233252162 — a DIFFERENT box and database from the
# larazen.in stack these values used to name. The old stack becomes the
# TEST environment and keeps its data; see infra/ENVIRONMENT_DESIGN.md.
# Nothing here points at larazen.in any more, on purpose.
# ─────────────────────────────────────────────────────────────────────

# API origin the SPA talks to. Browser-visible — no secret.
VITE_API_BASE_URL=https://api.jlmush.in

# Socket.IO origin for the real-time communication channel (Service Chats).
# The backend serves the /socket.io/ WebSocket handshake on the same origin as
# the API. Baked at build time like every VITE_* var (no runtime injection on
# Cloudflare Pages/Worker) — change here + redeploy.
VITE_SOCKET_URL=https://api.jlmush.in

# The DNS zone tenant subdomains live under: <slug>.jlmush.in. Must equal
# the backend's CLOUDFLARE_BASE_DOMAIN, or the "your site is at ..." copy
# shown after tenant signup names a host nobody provisioned.
VITE_PUBLIC_BASE_DOMAIN=jlmush.in

# Razorpay publishable key — DELIBERATELY EMPTY in production.
#
# Tenant-owned collection means there is no single correct key to bake in:
# each tenant checks out on its OWN Razorpay account, and every current
# flow (BookAppointment, FollowUpBanner, MembershipPlansPanel,
# PublicDoctorSlotsPage) reads `key_id` from the create-order response,
# which is the tenant's key for that order. A build-time key here would
# either be ignored or — worse — open checkout against the wrong account
# for an order created on someone else's gateway.
#
# The previous value was the old business's LIVE key; prod shares no
# credentials with that stack. The one remaining consumer,
# PatientDashboard's handlePay, still reads this var instead of the
# response — that call site is separately broken (it also destructures
# `rz_order_id`/`amount_paise`, which the endpoint does not return) and
# must be fixed to use `key_id` like its siblings.
VITE_RAZORPAY_KEY_ID=

# Phase-3 rollout switch. Default true during the rollout window.
# Flip to false after backend has BACKEND_TRUST_TENANT_HOST_HEADER=false
# in production AND telemetry confirms zero default_fallback hits
# from auth paths. Not a security boundary — backend is.
VITE_SEND_LEGACY_TENANT_HEADERS=true

# The SaaS vendor's own host(s), comma-separated (no protocol, no www).
#
# Under the one-domain model this is the SAME string as
# VITE_PUBLIC_BASE_DOMAIN above, and that is correct — jlmush.in is both
# the vendor's console/storefront AND the zone tenants live under. The
# older comment here warned they must differ; that was true when the
# vendor lived on its own domain (jlmushcloud.com, never registered) and
# is no longer the model. Do not "fix" them back apart.
#
# Must match the vendor tenant's own ``domain`` column — the value given
# to split_apex_tenant.py --vendor-domain. Pointing a domain at the
# frontend does NOT by itself make it the vendor: an undeclared host
# falls through to the is_default fallback, so it renders the vendor's
# content while the SPA still treats it as a tenant (/pricing hidden,
# /join shown). Declare a host in both places, or in neither.
#
# Do not empty it: anonymous visitors to the vendor's site would read as
# a tenant until /auth/me answers. That is exactly the symptom that made
# jlmush.in render as a Larazen tenant while this said jlmushcloud.com.
VITE_PLATFORM_APEX_HOSTS=jlmush.in
