VITE_API_BASE_URL=http://localhost:5001

# Socket.IO origin for the real-time communication channel (Service Chats).
# Same origin as the API — the backend serves the /socket.io/ handshake on the
# same port. Falls back to VITE_API_BASE_URL if unset.
VITE_SOCKET_URL=http://localhost:5001

# Bare localhost is treated as the vendor apex automatically; tenant hosts
# use <slug>.localhost (e.g. larazen.localhost).
VITE_PLATFORM_APEX_HOSTS=
