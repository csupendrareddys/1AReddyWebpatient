# Build-time env for the TEST environment (vite build --mode testing).
#
# Committed on purpose, same reasoning as .env.production: CI dashboard env
# vars didn't propagate reliably into the Vite build, so the committed file
# is the source of truth. Everything here is baked into the public bundle —
# publishable values only, never secrets.
#
# TEST HAS ITS OWN DOMAIN, fully separate from prod: jucf.org. The same
# value appears in worker/wrangler.toml ([env.test]) and the infra repo's
# envs/test/terraform.tfvars — change all three together or not at all.
#
# The domain model mirrors prod on one zone:
#   apex  = vendor console (like jlmushcloud.com in prod)
#   api.  = test backend  (DNS record created by Terraform envs/test)
#   <slug>. = tenants     (records created by the test backend at runtime)

# Test API origin (the test EC2 box). TLS terminates on the box, same as prod.
VITE_API_BASE_URL=https://api.jucf.org
VITE_SOCKET_URL=https://api.jucf.org

# Tenant hosts live at <slug>.<this>; cookies scope to .<this>. Must match
# CLOUDFLARE_BASE_DOMAIN on the test backend and base_domain in envs/test.
VITE_PUBLIC_BASE_DOMAIN=jucf.org

# Razorpay TEST publishable key (rzp_test_*) — never the live key here, so
# nothing bought on the test frontend can charge a real card.
VITE_RAZORPAY_KEY_ID=rzp_test_CHANGEME

VITE_SEND_LEGACY_TENANT_HEADERS=true

# The test apex plays the vendor role (prod: jlmushcloud.com), so vendor-mode
# pages — pricing, tenant signup, the platform console — are testable too.
VITE_PLATFORM_APEX_HOSTS=jucf.org
