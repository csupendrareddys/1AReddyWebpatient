# Frontend environment variables.
#
# Copy to .env.production (NOT committed) when building the production
# bundle, or set these in your hosting platform's build env (Amplify,
# Vercel, Netlify, etc.). Only variables prefixed with ``VITE_`` are
# exposed to the browser at build time.

# ── Backend API ──────────────────────────────────────────────
# Where the SPA sends API requests. Production: point at the public
# API origin (e.g. https://api.larazen.in). Dev: localhost backend.
VITE_API_BASE_URL=https://api.larazen.in

# ── Real-time channel (Socket.IO) ────────────────────────────
# Origin serving the /socket.io/ handshake (the Service Chats channel).
# Normally the same as VITE_API_BASE_URL. Falls back to it when unset.
VITE_SOCKET_URL=https://api.larazen.in

# ── Tenant routing ───────────────────────────────────────────
# CRITICAL — the platform's apex/base domain. Used by
# ``useIsOnPlatformDomain()`` to decide whether the browser is on the
# platform marketing site (apex / www.<base>) vs a tenant subdomain
# or custom domain.
#
# Without this set, the hook fails CLOSED — every real DNS hostname
# is treated as a tenant. That's safer than the old behaviour
# (treat-as-platform) which routed tenant custom domains to the
# platform landing and showed marketing pages on customer URLs.
#
# Production MUST set this. Dev (localhost) is the only case where
# the absence is benign (localhost is treated as platform regardless).
VITE_PUBLIC_BASE_DOMAIN=larazen.in

# ── Optional: forced tenant slug for local preview ───────────
# When set, useTenantSlug() returns this value instead of resolving
# from the hostname. Useful for previewing a specific tenant against
# a local dev backend without DNS.
# VITE_TENANT_SLUG=acme-clinic

# ── Phase 3 rollout switch ───────────────────────────────────
# Whether axios sends the legacy ``X-Tenant-Host`` / ``X-Tenant-Slug``
# headers. Default ``true`` (rollout window). Flip to ``false`` once
# the production backend has BACKEND_TRUST_TENANT_HOST_HEADER=false
# and Phase 1 telemetry confirms zero default_fallback hits.
# Not a security boundary — backend authorization is server-side and
# host-validated. These are routing hints only.
# VITE_SEND_LEGACY_TENANT_HEADERS=true
