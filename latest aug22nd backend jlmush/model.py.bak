class DoctorQualificationSpecialization(db.Model):
    """Doctor's specializations."""
    __tablename__ = 'doctor_qualification_specializations'
    
    id = db.Column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4, name='specialization_id')
    doctor_id = db.Column(UUID(as_uuid=True), db.ForeignKey('doctors.doctor_id', ondelete='CASCADE'), nullable=False, index=True)
    category_id = db.Column(UUID(as_uuid=True), db.ForeignKey('categories.category_id'), nullable=False, index=True)
    
    years_experience = db.Column(db.Integer, nullable=True)
    is_primary = db.Column(db.Boolean, default=False, nullable=False)
    
    created_at = db.Column(db.DateTime, default=utcnow, nullable=False)
    updated_at = db.Column(db.DateTime, default=utcnow, onupdate=utcnow, nullable=False)
    
    doctor = db.relationship('Doctor', back_populates='specializations')
    category = db.relationship('Category', back_populates='specializations')

    __table_args__ = (
        db.UniqueConstraint('doctor_id', 'category_id', name='uq_doctor_specialization'),
    )

    def to_dict(self):
        return {
            'id': str(self.id),
            'category_name': self.category.name if self.category else None,
            'years_experience': self.years_experience,
            'is_primary': self.is_primary,
        }

