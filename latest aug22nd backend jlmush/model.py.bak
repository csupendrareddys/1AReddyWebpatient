class UserStatus(enum.Enum):
    ACTIVE = 'active'
    INACTIVE = 'inactive'
    PENDING = 'pending'
    BLOCKED = 'blocked'

class UserRole(enum.Enum):
    SUPER_ADMIN = 'super_admin'
    SUB_ADMIN = 'sub_admin'
