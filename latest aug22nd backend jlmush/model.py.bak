            'id': str(self.id),
            'name': self.name,
            'is_active': self.is_active,
            'created_at': self.created_at.isoformat() if self.created_at else None,
        }

    def __repr__(self):
        return f"<MasterCollege {self.name}>"


class Address(db.Model):
