    DOCTOR = 'doctor'
    PHARMACY = 'pharmacy'
    DIAGNOSIS = 'diagnosis'

# ... (lines 41-499 skipped) ...

    def is_expired(self):
        """Check if session has expired (either soft or hard expiry)."""
        now = utcnow()
        
        expires = self.expires_at
        if expires and expires.tzinfo is None:
            expires = expires.replace(tzinfo=timezone.utc)
            
        absolute = self.absolute_expiry
        if absolute and absolute.tzinfo is None:
            absolute = absolute.replace(tzinfo=timezone.utc)
            
        return now > expires or now > absolute

