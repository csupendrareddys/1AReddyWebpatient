"""
RBAC (Role-Based Access Control) Models for Healthcare Sub-Admin System
========================================================================

Architecture Overview:
- Role: Named collection of permissions (e.g., "Operational Team Junior", "Senior Manager")
- Permission: Granular access control per module + action + data range
- SubAdminRole: Links Admin users to one or more Roles
- ApprovalRequest: Workflow for doctor/patient profile changes requiring admin approval

Permission Actions:
  VIEW   - Read-only access (data analysis teams)
  EDIT   - Modify basic/non-sensitive fields
  UPDATE - Modify sensitive/high-security fields (triggers approval workflow)
  CREATE - Create new records
  DELETE - Soft-delete records

Verification Levels (tied to role levels):
  L1_VERIFIER - Can approve Level 1 verifications (customer support)
  L2_VERIFIER - Can approve Level 2 verifications (sub admin)
  L3_VERIFIER - Can approve Level 3 verifications (super admin)

Data Range: Controls how far back in time the role can access data
  LAST_15_DAYS, LAST_32_DAYS, 1_MONTH, 2_MONTHS, 60_DAYS, 90_DAYS, 180_DAYS, 360_DAYS, ALL

Lock/Unlock: Can the role lock/unlock user accounts
"""

import uuid
import enum
from datetime import datetime, timezone
from sqlalchemy.dialects.postgresql import UUID, JSON
from sqlalchemy import Index, CheckConstraint

from app.extensions import db


def utcnow():
    """Returns timezone-aware datetime (matching your existing convention)."""
    return datetime.now(timezone.utc)


# ============================================================================
# ENUMS
# ============================================================================

class PermissionAction(enum.Enum):
    """Core permission actions."""
    FULL_ACCESS = 'full_access'
    VIEW = 'view'
    CREATE = 'create'
    EDIT = 'edit'          # Basic/non-sensitive fields
    UPDATE = 'update'      # High-sensitivity fields (triggers approval)
    DELETE = 'delete'
    L1_VERIFIER = 'l1_verifier'
    L2_VERIFIER = 'l2_verifier'
    L3_VERIFIER = 'l3_verifier'
    LOCK = 'lock'
    UNLOCK = 'unlock'


