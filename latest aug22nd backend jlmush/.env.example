# ────────────────────────────────────────────────────────────────
# jlmushIITM Backend — environment variables template
#
# Copy this file to `.env` (for local dev) or `.env.test` / `.env.production`
# (on the EC2 host). NEVER commit the real filled-in file — .gitignore
# already excludes .env and .env.*.
#
# For local dev generate the cryptographic keys like this:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"     # ENCRYPTION_KEY
#   python -c "import secrets; print(secrets.token_urlsafe(64))"                                    # SECRET_KEY, JWT_SECRET_KEY
# ────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=replace-with-random-64-char-string
JWT_SECRET_KEY=replace-with-random-64-char-string

# ── JWT token lifetimes (optional) ───────────────────────────
# Override the built-in defaults. Unset/blank/invalid/<=0 falls back to the
# default, so a typo can never produce a near-zero expiry.
# Defaults: access = 10 min (prod) / 30 min (dev); refresh = 10 days (prod) / 12 h (dev).
# JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60      # e.g. 60 = 1-hour access token
# JWT_REFRESH_TOKEN_EXPIRES_DAYS=10

# ── Encryption (Fernet key for DB column encryption) ─────────
# MUST be a valid Fernet key: 32 bytes url-safe base64 (44 chars ending in =)
ENCRYPTION_KEY=replace-with-fernet-generate-key

# ── Database (PostgreSQL) ────────────────────────────────────
# Local dev: point at docker compose / localhost postgres
# Test env:  point at dedicated RDS test instance
# Prod:      point at RDS prod instance (use sslmode=verify-full)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jlmush_dev

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://:devpassword@localhost:6379/0
REDIS_PASSWORD=devpassword
REDIS_MAXMEMORY=256mb

# ── CORS / frontend ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ── AWS: S3 (asset buckets) ──────────────────────────────────
AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_REGION=ap-south-1
AWS_S3_PUBLIC_BUCKET=jlmush-assets-public-dev
AWS_S3_PRIVATE_BUCKET=jlmush-data-private-dev

# ── MinIO: local S3 for the PRIVATE bucket only ──────────────
# LEAVE ALL OF THESE UNSET IN PRODUCTION. Setting MINIO_ENDPOINT_URL routes
# every private-bucket operation (certificates, prescriptions, doctor identity
# documents, signatures, service-communication attachments) at a local MinIO,
# so those flows work with no AWS credentials and no patient data leaves the
# machine. The PUBLIC bucket is never routed — it keeps hitting real S3 so a
# restored prod DB still pulls live logos and homepage assets.
#
# docker-compose.yml already sets these for the dev stack; listed here for
# anyone running the backend outside Docker.
#
# Two endpoints are needed because SigV4 signs the Host header: a URL
# presigned against the in-network host is rejected when the browser fetches
# it from localhost.
#
# AWS_S3_PRIVATE_BUCKET must match the bucket created in MinIO.
# MINIO_ENDPOINT_URL=http://minio:9000
# MINIO_PUBLIC_ENDPOINT_URL=http://localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_REGION=us-east-1

# AWS Amplify was retired in favour of Cloudflare Pages + Workers for
# the SPA and Cloudflare for SaaS for tenant custom-domain provisioning.
# See the CLOUDFLARE_SAAS_* block below.

# ── Combirds / Edumarc SMS (transactional SMS + OTP) ─────────
# Combirds is the SMS/email/WhatsApp provider replacing AWS SES.
# COMBIRDS_API_KEY is the GUID issued by Edumarc for your account.
# Per-template wiring (template IDs, bodies, sender headers) lives in the
# ``notification_templates`` DB table — NOT here — so templates can be
# edited at runtime as DLT approvals trickle in. See
# Backend/app/models/notification_template.py.
COMBIRDS_API_KEY=replace-with-edumarc-guid
COMBIRDS_SMS_URL=https://smsapi.edumarcsms.com/api/v1/sendsms
COMBIRDS_STATUS_URL=https://api.edumarcsms.com/api/v1/org/transaction

# ── SendClean (transactional email) ──────────────────────────
# Owner ID + token come from the SendClean dashboard. APP_DOMAIN defaults
# to sendclean.net (the docs example uses us1-mta1.sendclean.net but that's
# an internal MTA hostname that returns AuthenticationError for /messages/*;
# the public API base is api.sendclean.net). SMTP_USER is the smtp_user_name
# string created under Account → SMTP Users. FROM_EMAIL must be on a
# verified sending domain (Account → Sending Domains).
# Per-template HTML + subject lives in the notification_templates DB
# table (channel='email'), NOT here.
SENDCLEAN_OWNER_ID=replace-with-sendclean-owner-id
SENDCLEAN_TOKEN=replace-with-sendclean-token
SENDCLEAN_APP_DOMAIN=sendclean.net
SENDCLEAN_SMTP_USER=replace-with-smtp-user-name
SENDCLEAN_FROM_EMAIL=noreply@example.com
SENDCLEAN_FROM_NAME=LARAZEN

# ── Razorpay (COLLECTION — patient → platform payins) ────────
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# ── Cashfree Payouts V2 (DISBURSAL — platform → doctor) ──────
# Leave BLANK to keep the current manual-settle behaviour (no disbursal calls).
# Set both creds to enable real Cashfree payouts. The client secret also verifies
# the payout webhook signature. Dashboard → Developers → API Keys (Payouts).
CASHFREE_PAYOUT_ENV=sandbox          # sandbox | production
CASHFREE_PAYOUT_CLIENT_ID=replace-me
CASHFREE_PAYOUT_CLIENT_SECRET=replace-me

# ── Cloudflare DNS (per-tenant subdomain provisioning) ──────
# When a PLATFORM_OWNER creates a tenant with slug ``acme``, the backend
# calls Cloudflare to create ``acme.${CLOUDFLARE_BASE_DOMAIN}`` as a CNAME
# to ``${CLOUDFLARE_INGRESS_TARGET}``. The token needs exactly one scope:
# "Zone → DNS → Edit" on the target zone.
CLOUDFLARE_API_TOKEN=replace-with-scoped-token
CLOUDFLARE_ZONE_ID=replace-with-zone-id
# REQUIRED even with Cloudflare disabled: this is the zone that
# ``<slug>.<zone>`` tenant subdomains resolve under, and host resolution
# has no database fallback for it. Use ``localhost`` for local dev.
# It is NOT the vendor's own host -- after the vendor/customer split the
# zone stays with the customer that owns it.
CLOUDFLARE_BASE_DOMAIN=example.com
# ``CLOUDFLARE_INGRESS_TARGET`` is the platform-managed
# ``<slug>.<base_domain>`` CNAME target — i.e. the hostname our
# OWN slug subdomains point at (e.g. ``acme.larazen.in CNAME →
# CLOUDFLARE_INGRESS_TARGET``). Should be a hostname bound to your
# Cloudflare Pages project — usually the Pages-native
# ``<project>.pages.dev``. Distinct from the tenant CNAME target
# which is configured via ``CLOUDFLARE_PAGES_TARGET`` in the Pages
# block below.
CLOUDFLARE_INGRESS_TARGET=jlmushfrontend.pages.dev
CLOUDFLARE_PROXIED=true
CLOUDFLARE_TTL=1

# ── Cloudflare Pages (per-tenant custom domain provisioning) ──
# Used by ``app/services/cloudflare_saas.py`` to add each tenant's
# verified custom domain to the Cloudflare Pages project as a Custom
# Domain. Mimics the prior AWS Amplify ``CreateDomainAssociation``
# flow: after ``DomainVerificationService`` confirms the tenant
# published the platform's TXT challenge, backend POSTs to the Pages
# API which issues the TLS cert and starts routing tenant traffic.
# Zero per-tenant dashboard work.
#
# An earlier iteration used CF for SaaS / Custom Hostnames API —
# abandoned because same-account-origin SaaS forwarding loopbacks to
# 522 on the Free SSL-for-SaaS plan. Pages-direct doesn't have that
# loopback because there's only one routing surface (Pages itself).
#
# Token scope: ``Account → Cloudflare Pages → Edit``. Can be the same
# token used in the DNS block above if scopes overlap.
#
# ``CLOUDFLARE_PAGES_TARGET`` is what tenants are told to CNAME to at
# their own registrar (shown in the DNS instructions dialog).
# Defaults to ``<project>.pages.dev`` when unset. Override if you've
# bound the Pages project to a hostname inside your own zone (e.g.
# ``www.larazen.in``) and want tenants to CNAME there instead — both
# work, ``.pages.dev`` is more general.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT_NAME=jlmushfrontend
CLOUDFLARE_PAGES_TARGET=

# ── Twilio (video calls) ─────────────────────────────────────
# Note: TWILIO_ACCOUNT_SID is your account ID, not a secret — but the API
# key sid/secret pair below IS sensitive.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=replace-me

# ── Optional: ports / binding ────────────────────────────────
# Override defaults if you have a port conflict locally.
# POSTGRES_PORT=5433
# REDIS_PORT=6380
# BACKEND_PORT=5000
